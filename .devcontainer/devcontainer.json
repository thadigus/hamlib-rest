{
  "name": "hamlib-rest",
  "build": {
    "dockerfile": "devcontainer/Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/hamlib-rest",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/hamlib-rest,type=bind",
  "forwardPorts": [
    8080
  ],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "NixOS.nix-build"
      ]
    }
  },
  "postCreateCommand": "bash devcontainer/nix-dev.sh",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  }
}
